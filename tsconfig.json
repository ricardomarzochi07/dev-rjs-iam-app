{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "preserve", // ✅ necessário para evitar erro de jsx-dev-runtime
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true, // Next.js cuida da build
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".", // base para caminhos absolutos
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "node",
      "react",
      "react-dom"
    ], // ✅ para autocomplete correto e JSX
    "skipLibCheck": true // evita erro de verificação em libs externas
    ,
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ],

}
